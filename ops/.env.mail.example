# Copy this file to ops/.env.mail and fill in ONE of the two options below.
# ops/.env.mail is git-ignored: never commit real keys or passwords.
# After editing, restart the API:  docker compose -f ops/docker-compose.yml up -d api

# ---- Option 1: Resend (https://resend.com) --------------------------------
# Without a verified domain Resend only delivers to the email of your own
# Resend account (use onboarding@resend.dev as the sender while testing).
# To email other people, verify a domain in Resend and use an address on it.
#RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#OTP_FROM_EMAIL=FilsPay <onboarding@resend.dev>

# ---- Option 2: SMTP (Gmail or any mail server) -----------------------------
# Gmail: turn on 2-step verification, create an "App password", use it below.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-letter-app-password
#MAIL_FROM=FilsPay <you@gmail.com>

# If both are set, Resend is used.

# ---- Links inside emails (change when you deploy) ---------------------------
#ADMIN_CONSOLE_URL=http://localhost:5174
#DASHBOARD_URL=http://localhost:5173
