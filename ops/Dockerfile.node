# syntax=docker/dockerfile:1

FROM node:22.14.0-bookworm-slim AS dependencies
WORKDIR /app

# argon2 may need a native build when no prebuilt binary matches the target.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy every workspace manifest so npm can resolve the monorepo during ci.
COPY package.json package-lock.json ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/reporting/package.json ./apps/reporting/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY packages/events/package.json ./packages/events/package.json
COPY packages/money/package.json ./packages/money/package.json

RUN --mount=type=cache,target=/root/.npm npm ci

FROM node:22.14.0-bookworm-slim AS runtime
ENV HOME=/home/node
WORKDIR /app

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps ./apps
COPY --chown=node:node packages ./packages
COPY --chown=node:node db ./db
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node tsconfig.base.json tsconfig.json ./

# Private KYC uploads live in a named volume mounted here (see docker-compose.prod.yml); the directory is
# created owned by `node` so the volume starts writable.
RUN mkdir -p /var/lib/filspay/kyc && chown -R node:node /var/lib/filspay

USER node
EXPOSE 3000
CMD ["npm", "run", "dev", "--workspace", "@filspay/api"]
