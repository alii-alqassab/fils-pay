# HTTPS (automatic certificates), the two single-page frontends, and the API proxy.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$APP_HOST} {
	import security_headers
	encode zstd gzip
	root * /srv/web
	try_files {path} /index.html
	file_server
}

{$ADMIN_HOST} {
	import security_headers
	encode zstd gzip
	root * /srv/admin
	try_files {path} /index.html
	file_server
}

{$API_HOST} {
	import security_headers
	encode zstd gzip
	reverse_proxy api:3000
}
